# ============================================================================
# PromptHub 环境变量模板
#
# 本项目使用 3 个环境文件：
#   .env              → 本地开发环境（npm run dev 直接读取）
#   .env.docker.prod  → 生产环境（docker compose --env-file 加载）
#   .env.example      → 模板（本文件，可提交到 git）
#
# 使用方法：
#   开发环境: cp .env.example .env  然后修改数据库密码等
#   生产环境: cp .env.example .env.docker.prod  然后修改所有密码和密钥
# ============================================================================

# ============ 本地开发环境变量（npm run dev 使用） ============
# 仅 .env 文件需要以下两个变量，docker compose 部署不需要
DATABASE_URL="mysql://root:your_password@localhost:3306/prompt_hub"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"


# ============ Docker 部署变量（.env.docker.prod 使用） ============
# docker compose 会读取以下变量，组装成 DATABASE_URL 传入容器

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=prompt_hub
MYSQL_USER=prompthub
MYSQL_PASSWORD=change-me-app-password
# MySQL 宿主机映射端口（避免与本机 MySQL 冲突时修改）
MYSQL_PORT=3306

# ---------- 应用配置 ----------
# 对外暴露端口（浏览器访问端口）
APP_PORT=8081

# JWT 密钥（生产环境务必修改！可用 openssl rand -base64 48 生成）
JWT_SECRET=please-change-this-jwt-secret-in-production
JWT_EXPIRES_IN=7d

# 是否在首次启动时执行 seed（注入默认管理员与示例 prompt）
RUN_SEED=true

# ---------- OAuth 第三方登录配置（可选） ----------
# OAuth 回调基础 URL（必须是 GitHub OAuth App 后台配置的回调地址的根域名）
# 本地开发：http://localhost:3000
# 生产部署：http://你的服务器IP:8081
OAUTH_CALLBACK_BASE_URL=http://localhost:8081

# GitHub OAuth App（申请：https://github.com/settings/developers）
# 回调 URL 填：${OAUTH_CALLBACK_BASE_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# HTTP 部署（无 HTTPS）必须设为 true，否则浏览器不会发送 secure cookie
# 配置了 HTTPS 反向代理后改为 false
OAUTH_INSECURE_COOKIE=false
