# ============================================================================
# PromptHub 环境变量模板
#
# 本项目使用 3 个环境文件：
#   .env.example      → 模板（本文件，可提交 git）
#   .env.docker.dev   → Docker 开发环境（由 .env.example 复制后修改）
#   .env.docker.prod  → Docker 生产环境（由 .env.example 复制后修改）
#
# 使用方法：
#   开发: cp .env.example .env.docker.dev   然后修改密码 / 密钥
#   生产: cp .env.example .env.docker.prod  然后修改密码 / 密钥 / 服务器IP
#
# 本地 npm 开发（非 Docker）如需使用，可：
#   cp .env.example .env
#   并补充 DATABASE_URL="mysql://用户:密码@localhost:3306/prompt_hub"
# ============================================================================

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=prompt_hub
MYSQL_USER=prompthub
MYSQL_PASSWORD=change-me-app-password

# ---------- 应用配置 ----------
# 对外暴露端口（浏览器访问端口，固定 8081）
APP_PORT=8081

# JWT 密钥（生产环境务必修改！建议用 openssl rand -base64 48 生成）
JWT_SECRET=please-change-this-jwt-secret-in-production
JWT_EXPIRES_IN=7d

# 是否在首次启动时执行 seed（注入默认管理员与示例 prompt）
# 首次启动后可改为 false 加快启动
RUN_SEED=true

# ---------- OAuth 第三方登录配置（可选） ----------
# OAuth 回调基础 URL（必须是 GitHub OAuth App 后台配置的回调地址的根域名）
# 本地开发：http://localhost:8081
# 生产部署：http://你的服务器IP:8081
OAUTH_CALLBACK_BASE_URL=http://localhost:8081

# GitHub OAuth App（申请：https://github.com/settings/developers）
# 回调 URL 填：${OAUTH_CALLBACK_BASE_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# HTTP 部署（无 HTTPS）必须设为 true，否则浏览器不会发送 secure cookie
# 配置了 HTTPS 反向代理后改为 false
OAUTH_INSECURE_COOKIE=true
